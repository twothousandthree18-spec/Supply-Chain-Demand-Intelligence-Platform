# Supply Chain & Demand Intelligence Platform
# .env.example - DOCUMENTATION ONLY. Never put real secrets in this file.
# Copy to .env (gitignored) or use Kaggle's kaggle.json to supply credentials
# for the official M5 data source. See docs/dataset_strategy.md.

# --- M5 data acquisition (Kaggle) ---
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_token

# --- PostgreSQL (Phase 2 Data Engineering; placeholder values) ---
# The project database is supply_chain_intelligence.
# Local dev server uses `trust` auth (no password needed); if your server
# requires a password, set PGPASSWORD in your real .env (never here).
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=supply_chain_intelligence
PGUSER=postgres
# PGPASSWORD=change_me
